# ─────────────────────────────────────────────────────────────────────────────
# REBOUND Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit real keys to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini AI (server-side only) ─────────────────────────────────────────────
# Required for live Gemini-backed features. Server-side only – never expose.
GEMINI_API_KEY=

# Optional: override the Gemini model. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# ── Supabase (cloud persistence + Google OAuth) ───────────────────────────────
# Get these from your Supabase project → Settings → API
# VITE_ prefix makes these available to the Vite browser client (safe: public keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Note: VITE_SUPABASE_ANON_KEY and NEXT_PUBLIC_* equivalents are also supported for backwards compatibility.

# Server-side Supabase service role key (for admin operations if needed).
# Keep this SECRET – never put it in VITE_ variables.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Server ────────────────────────────────────────────────────────────────────
# Optional HTTP port (default 3000).
PORT=3000
